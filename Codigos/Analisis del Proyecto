# 11. CORRELACIÓN DE CADA VARIABLE CON EL % DE ENFERMOS
# =====================================================================
# Pegar a continuación de la sección 10.
#
# ¿Por qué el heatmap daba correlaciones bajas (0,24 para la edad)?
# Porque 'cardio' solo vale 0 o 1. Dos pacientes de 60 años pueden ser uno
# sano y otro enfermo, y eso "rompe" la correlación paciente por paciente.
#
# Acá hacemos otra cosa: agrupamos a los pacientes (por ejemplo, todos los de
# 50 años juntos) y calculamos el % de enfermos de cada grupo. Después
# correlacionamos la variable con ese %. Así se ve la tendencia real.

NARANJA, AZUL = "#D85A30", "#4C72B0"


def correlacion_por_grupo(ax, columna, ancho_grupo, nombre):
    """Punto = un grupo de pacientes. Eje Y = % de ese grupo que tiene ECV."""
    grupo = (datos_limpios[columna] // ancho_grupo) * ancho_grupo
    tabla = datos_limpios.groupby(grupo)["cardio"].agg(["mean", "size"])
    tabla = tabla[tabla["size"] >= 100]          # descartamos grupos con muy pocos pacientes
    x, y = tabla.index.to_numpy(dtype=float), tabla["mean"].to_numpy() * 100

    r_grupo = np.corrcoef(x, y)[0, 1]
    r_individual = datos_limpios[columna].corr(datos_limpios["cardio"])

    ax.scatter(x, y, s=tabla["size"] / 40, color=AZUL, alpha=0.7)   # punto más grande = más pacientes
    pendiente, ordenada = np.polyfit(x, y, 1)
    ax.plot(x, pendiente * x + ordenada, color=NARANJA, linewidth=2.5)

    ax.text(0.05, 0.95, f"Correlación: {r_grupo:.2f}", transform=ax.transAxes,
            fontsize=13, fontweight="bold", va="top")
    ax.set(xlabel=nombre, ylabel="% de pacientes con ECV", ylim=(0, 100))
    for lado in ("top", "right"):
        ax.spines[lado].set_visible(False)
    ax.grid(alpha=0.3)
    return r_individual, r_grupo


# ---------------------------------------------------------------------
# 11.1 Edad, presión sistólica e IMC vs % de enfermos
# ---------------------------------------------------------------------
fig, axes = plt.subplots(1, 3, figsize=(16, 5))
resultados = {
