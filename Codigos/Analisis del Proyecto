# 10. ¿QUÉ VARIABLES SE RELACIONAN CON LA ENFERMEDAD CARDIOVASCULAR?
# =====================================================================
# Pegar a continuación de la sección 9.
# Idea: para cada variable miramos QUÉ PORCENTAJE de pacientes tiene ECV en
# cada grupo. Si el porcentaje cambia mucho entre grupos, la variable sirve
# para predecir. Si queda todo parecido, no sirve.
#   - Naranja = más ECV que el promedio
#   - Azul    = menos ECV que el promedio

NARANJA, AZUL = "#D85A30", "#4C72B0"
promedio = datos_limpios["cardio"].mean() * 100   # ~49,5%


def grafico_porcentaje(columna, nombres, titulo, xlabel):
    """Gráfico de barras: % de pacientes con ECV en cada grupo de 'columna'."""
    porcentaje = datos_limpios.groupby(columna, observed=True)["cardio"].mean() * 100
    porcentaje = porcentaje.reindex(list(nombres.keys()))
    colores = [NARANJA if p > promedio else AZUL for p in porcentaje]

    fig, ax = plt.subplots(figsize=(8, 5))
    barras = ax.bar(list(nombres.values()), porcentaje, color=colores)
    ax.bar_label(barras, fmt="%.0f%%", padding=3, fontsize=11)
    ax.axhline(promedio, color="gray", linestyle="--", linewidth=1,
               label=f"Promedio de todos los pacientes ({promedio:.0f}%)")
    ax.legend(loc="upper left", frameon=False)

    ax.set(title=titulo, xlabel=xlabel, ylabel="% de pacientes con ECV", ylim=(0, 100))
    for lado in ("top", "right"):
        ax.spines[lado].set_visible(False)
    plt.tight_layout()
    plt.show()


