    "Presión sistólica": correlacion_por_grupo(axes[1], "ap_hi", 10, "Presión sistólica (mmHg)"),
    "IMC":               correlacion_por_grupo(axes[2], "imc", 2, "IMC (kg/m²)"),
}
fig.suptitle("A medida que aumenta cada variable, aumenta el % de pacientes con ECV",
             fontsize=14)
plt.tight_layout()
plt.show()
# Cada punto es un grupo de pacientes (ej: todos los de 50 años).
# Conclusión: las tres variables tienen una relación casi perfecta con el % de enfermos.
# Por cada año de edad, por cada 10 mmHg de presión y por cada punto de IMC, sube el riesgo.
# Detalle: en la presión la subida es más fuerte entre 120 y 140 y después se
# estabiliza cerca del 85% (forma de "S"), por eso la recta no ajusta perfecto.


